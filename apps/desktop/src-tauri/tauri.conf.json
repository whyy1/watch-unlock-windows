{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watch Unlock",
  "mainBinaryName": "WatchUnlock",
  "version": "0.2.9",
  "identifier": "org.watchunlock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Watch Unlock",
        "width": 1320,
        "height": 960,
        "minWidth": 820,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "whyy1",
    "homepage": "https://github.com/whyy1/watch-unlock-windows",
    "license": "AGPL-3.0-only",
    "shortDescription": "Unlock Windows with an Apple Watch nearby",
    "resources": {
      "../../../backend/target/release/watchd.exe": "watchd.exe",
      "../../../backend/target/release/watchd-supervisor.exe": "watchd-supervisor.exe",
      "../../../backend/target/release/watch_unlock_provider.dll": "watch_unlock_provider.dll",
      "../../../LICENSE": "LICENSE.txt",
      "../../../NOTICE": "NOTICE.txt",
      "../../../licenses/": "licenses/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./installer.nsh",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0NTYwNjQxMDQ4M0VBMDAKUldRQTZvTUVRUVpXVk44RGg3dzh2V2pwL2tXbmFxY0JlblRMaUw1UlJLTyszNkhjYlI4ZmRIUUgK",
      "endpoints": [
        "https://gitee.com/why_y1/watch-unlock-windows/raw/main/updates/latest-gitee.json",
        "https://github.com/whyy1/watch-unlock-windows/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
